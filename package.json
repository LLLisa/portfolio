{
    "name": "lisa-portfolio",
    "version": "2.0.0",
    "description": "Personal portfolio of Lisa Anne Knox",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "start": "ts-node --transpile-only --project server/tsconfig.json server/index.ts",
        "start:dev": "npm run build && npm start",
        "heroku-postbuild": "npm run build",
        "deploy": "git add . && git commit -m Heroku && git push && git push heroku main"
    },
    "engines": {
        "node": "20.x"
    },
    "keywords": [],
    "author": "Lisa Anne Knox",
    "license": "ISC",
    "dependencies": {
        "express": "^4.18.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.0.3"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/express": "^4.17.17",
        "@types/react": "^18.0.31",
        "@types/react-dom": "^18.0.11",
        "@vitejs/plugin-react": "^4.2.1",
        "jsdom": "^24.1.3",
        "vite": "^5.2.0",
        "vitest": "^1.6.1"
    }
}
